    "fact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "knowledge": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "knowledge": {
