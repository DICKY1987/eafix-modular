* text=auto

*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

*.pdf binary
*.docx binary
*.db binary
*.db-shm binary
*.db-wal binary

# Evidence bytes must survive Git checkout unchanged; receipts hash originals.
governance/module_consolidation/inputs/** -text -eol
governance/module_consolidation/staging/*/manifest.v1.original.json -text -eol
governance/module_consolidation/run/baseline_tracking/** -text -eol
archive/module-supporting-docs/**/original.* -text -eol
